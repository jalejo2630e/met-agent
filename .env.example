APP_NAME="Administrador de Agentes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# En producción con HTTPS, usar la URL completa con https (evita Mixed Content en assets):
# APP_URL=https://seguralia.adminainoa.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase (PostgreSQL)
# Obtén la URL en: Supabase Dashboard → Project Settings → Database → Connection string (Session pooler)
# Reemplaza [password] con tu contraseña de base de datos de Supabase
# IMPORTANTE: Elige la región de Supabase cercana a tu servidor (Dokploy) para reducir latencia
DB_CONNECTION=pgsql
DB_URL=postgres://postgres.[PROJECT_REF]:[password]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DB_SSLMODE=require
# Conexiones persistentes: reutiliza la conexión entre requests (reduce latencia con Supabase)
DB_PERSISTENT=true

# Alternativa: variables individuales (si no usas DB_URL)
# DB_HOST=db.[PROJECT_REF].supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require

# Para desarrollo local con SQLite, usa:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Supabase — lectura de transcripciones y WhatsApp vía API REST (PostgREST) cuando el origen en Configuración es Supabase.
# Solo hacen falta URL + anon key (VITE_* o SUPABASE_* sin prefijo en services.php).
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
VITE_SUPABASE_ANON_KEY=

# Opcional (misma clave sin prefijo VITE):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Origen conversaciones WhatsApp / transcripciones: internal | supabase.
# En la app, Ajustes → "Origen de transcripciones" guardado en BD tiene prioridad sobre esta variable.
# Si los datos están solo en Supabase (PostgREST), usa supabase aquí y en Ajustes, y define VITE_SUPABASE_* / SUPABASE_*.
# WHATSAPP_CONVERSATIONS_SOURCE=internal
# CALL_TRANSCRIPTS_SOURCE=supabase
# Patrón de nombre de tabla en Supabase para WhatsApp (solo si origen = supabase). {agent_id} = ID numérico del agente.
# Prioridad: Ajustes en la app > esta variable > valor por defecto agent_{agent_id}_whatsapp_conversations
# WHATSAPP_SUPABASE_TABLE_PATTERN=agent_{agent_id}_whatsapp_conversations
# Columna PostgREST para filtrar por número (solo dígitos). session_id suele coincidir con proa_registro_whatsapp / tablas agent_*; phone si tu esquema lo usa.
# WHATSAPP_SUPABASE_PHONE_COLUMN=session_id
# Columnas devueltas por PostgREST (si no tienes created_at, no lo pongas).
# WHATSAPP_SUPABASE_SELECT_COLUMNS=id,message

# Conexión PostgreSQL "supabase" en config/database.php: solo si la usas para otras cosas (no para leer transcripciones/WhatsApp).
# SUPABASE_DATABASE_URL=
# SUPABASE_DB_PASSWORD=

# N8N (para sincronizar el system prompt del agente con el workflow)
# URL base de la API de N8N (ej: https://tu-instancia.n8n.io)
N8N_API_URL=
# API Key de N8N (Settings → API en tu instancia n8n)
API_N8N=

# ElevenLabs (llamadas de voz). El prompt del agente se administra en ElevenLabs.
ELEVENLABS_API_KEY=
# Webhook post-call a configurar: https://TU_DOMINIO/api/agents/{agent_id}/elevenlabs/post-call

# ── IA (Laravel AI SDK) ───────────────────────────────────────────────────
# Proveedor por defecto = openai (config/ai.php → 'default'). Necesario para el
# análisis de llamadas (ai:analyze-calls) y el agente nativo de WhatsApp/Twilio.
OPENAI_API_KEY=

# ── Twilio (canal WhatsApp/SMS del agente NATIVO de Laravel, reemplaza n8n) ─
# En Twilio → "When a message comes in" (POST):
#   https://TU_DOMINIO/api/agents/{agent_id}/twilio/whatsapp
# TWILIO_AUTH_TOKEN valida la firma del webhook (recomendado en producción).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Laravel 13: fija prefijos para no invalidar caché/sesión tras el deploy ─
CACHE_PREFIX=colsanitas_cache
SESSION_COOKIE=colsanitas_session

# Registros de llamadas / transcripciones (tabla public.registro_escrito_llamada en Supabase: columnas phone, campana text, agent_id text, transcript text…)
# Valor que debe coincidir con la columna campana (y filtra junto con teléfono del cliente en el popup):
CAMPANA_AINOA=
# Columna de campaña: en Supabase es "campana" (text). Migración local puede usar campana_id:
# CAMPANA_AINOA_COLUMN=campana
# REGISTRO_ESCRITO_LLAMADAS_TABLE=registro_escrito_llamada
# Tabla de audio (Supabase): audio en text base64, índice por conversation_id
# REGISTRO_AUDIO_LLAMADAS_TABLE=registro_audio_llamadas
